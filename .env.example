# Genesis Engine Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED API KEYS
# ===========================================

# GenSpark API Key (get from https://genspark.ai)
GENESIS_API_KEY=your_genspark_api_key_here

# GitHub Personal Access Token
# Required scopes: repo, workflow, read:org
GITHUB_TOKEN=your_github_token_here

# ===========================================
# AI MODEL PROVIDERS (Optional)
# ===========================================

# OpenAI API Key (for GPT-4 code generation)
OPENAI_API_KEY=

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=

# ===========================================
# DEPLOYMENT PLATFORMS (Optional)
# ===========================================

# Vercel Token (for Vercel deployments)
VERCEL_TOKEN=

# Cloudflare API Token (for Workers/Pages)
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Railway Token
RAILWAY_TOKEN=

# Render Token
RENDER_TOKEN=

# Fly.io Token
FLY_ACCESS_TOKEN=

# ===========================================
# NOTIFICATIONS (Optional)
# ===========================================

# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Slack Webhook URL
SLACK_WEBHOOK_URL=

# Email (SMTP) Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=genesis@yourdomain.com

# ===========================================
# REVENUE & ANALYTICS (Optional)
# ===========================================

# Stripe API Key (for revenue tracking)
STRIPE_API_KEY=

# Plausible Analytics
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=

# ===========================================
# MONITORING (Optional)
# ===========================================

# Grafana Admin Credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=genesis123

# Sentry DSN (for error tracking)
SENTRY_DSN=

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# Genesis mode (manual, semi-auto, autonomous)
GENESIS_MODE=manual

# Maximum concurrent projects
MAX_CONCURRENT_PROJECTS=5

# Auto-deploy threshold (0-100)
AUTO_DEPLOY_THRESHOLD=85
